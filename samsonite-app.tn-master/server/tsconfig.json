{

    "compilerOptions": {
    "target": "ES2022",

    "module": "ES2022",

    "moduleResolution": "bundler",

    "esModuleInterop": true,

    "strict": true,

    "outDir": "dist",

    "rootDir": ".",

    "resolveJsonModule": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "types": ["node"],

    "lib": ["ES2022"]
  },

  "include": [
    "src",
    "scripts",
    "prisma.config.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}